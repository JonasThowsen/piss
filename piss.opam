# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A durable, harness-agnostic control plane for coding agents"
maintainer: ["Jonas Ådland Thowsen"]
authors: ["Jonas Ådland Thowsen"]
license: "MIT"
homepage: "https://github.com/JonasThowsen/piss"
bug-reports: "https://github.com/JonasThowsen/piss/issues"
depends: [
  "ocaml" {= "5.5.0"}
  "dune" {>= "3.20"}
  "eio_main"
  "cohttp-eio"
  "yojson"
  "sqlite3"
  "logs"
  "fmt"
  "alcotest"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/JonasThowsen/piss.git"
x-maintenance-intent: ["(latest)"]
