+  const path = join(directory, 'mcp.json')
+  writeFileSync(path, `${JSON.stringify(merged, null, 2)}\n`, { mode: 0o600 })
+  let cleaned = false
+  const cleanup = () => {
+    if (cleaned) return
+    cleaned = true
