+    if (typeof server?.name !== 'string' || typeof server?.command !== 'string') continue
+    translated[server.name] = {
+      command: server.command,
+      args: Array.isArray(server.args) ? server.args.filter(arg => typeof arg === 'string') : [],
+      env: mcpEnvironment(server.env),
