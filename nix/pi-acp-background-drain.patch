+  private restoreBackgroundWork(ev: PiRpcEvent): void {
+    const prefix = 'PI_SUBAGENT_ASYNC_JSON:'
+    const lines = Array.isArray((ev as any).widgetLines) ? (ev as any).widgetLines : []
+    const line = lines.find((value: unknown) => typeof value === 'string' && value.startsWith(prefix))
+    const active = new Set<string>()
+
+    if (typeof line === 'string') {
+      try {
+        const snapshot = JSON.parse(line.slice(prefix.length))
+        if (snapshot?.kind === 'pi-subagents.async-status-snapshot' && snapshot?.version === 1) {
+          for (const run of Array.isArray(snapshot.runs) ? snapshot.runs : []) {
+            if (
+              run &&
+              typeof run.id === 'string' &&
+              (run.state === 'queued' || run.state === 'running')
+            ) {
+              active.add(run.id)
+            }
+          }
+        }
+      } catch {
+        return
+      }
+    }
+
+    this.backgroundWorkIds.clear()
+    for (const asyncId of active) this.backgroundWorkIds.add(asyncId)
+    this.emit({
+      sessionUpdate: 'session_info_update',
+      _meta: {
+        piAcp: {
+          queueDepth: this.turnQueue.length,
+          running: Boolean(this.pendingTurn || this.inAgentLoop || this.backgroundWorkIds.size > 0)
+        }
+      }
+    })
+  }
