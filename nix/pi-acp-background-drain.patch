diff --git a/test/component/session-queue-cancel.test.ts b/test/component/session-queue-cancel.test.ts
index ee45ae8..9a2d462 100644
--- a/test/component/session-queue-cancel.test.ts
+++ b/test/component/session-queue-cancel.test.ts
@@ -5,6 +5,134 @@ import { FakeAgentSideConnection, FakePiRpcProcess, asAgentConn } from '../helpe
 
 const nextTick = () => new Promise<void>(resolve => setImmediate(resolve))
 
+test('PiAcpSession: reports exact detached work from structured status snapshots', async () => {
+  const conn = new FakeAgentSideConnection()
+  const proc = new FakePiRpcProcess()
+
+  const session = new PiAcpSession({
+    sessionId: 's1',
+    cwd: process.cwd(),
+    mcpServers: [],
+    proc: proc as any,
+    conn: asAgentConn(conn),
+    fileCommands: []
+  })
+
+  const prompt = session.prompt('delegate twice')
+  proc.emit({ type: 'agent_start' })
+  for (const asyncId of ['run-1', 'run-2']) {
+    proc.emit({
+      type: 'tool_execution_end',
+      toolCallId: `launch-${asyncId}`,
+      toolName: 'subagent',
+      isError: false,
+      result: {
+        content: [{ type: 'text', text: `Async workflow [${asyncId}]` }],
+        details: { mode: 'workflow', asyncId }
+      }
+    })
+  }
+  proc.emit({ type: 'agent_end', messages: [], willRetry: false })
+  proc.emit({ type: 'agent_settled' })
+
+  assert.equal(await prompt, 'end_turn')
+  await nextTick()
+  assert.equal((conn.updates.at(-1)?.update as any)?._meta?.piAcp?.running, true)
+
+  proc.emit({
+    type: 'extension_ui_request',
+    id: 'widget-1',
+    method: 'setWidget',
+    widgetKey: 'subagent-async',
+    widgetLines: [
+      'PI_SUBAGENT_ASYNC_JSON:' + JSON.stringify({
+        kind: 'pi-subagents.async-status-snapshot',
+        version: 1,
+        runs: [
+          { id: 'run-1', state: 'complete' },
+          { id: 'run-2', state: 'running' }
+        ]
+      })
+    ]
+  })
+  await nextTick()
+  assert.equal(
+    (conn.updates.at(-1)?.update as any)?._meta?.piAcp?.running,
+    true,
+    'one remaining detached run must keep the ACP session active'
+  )
+
+  proc.emit({
+    type: 'extension_ui_request',
+    id: 'widget-clear',
+    method: 'setWidget',
+    widgetKey: 'subagent-async'
+  })
+  await nextTick()
+  assert.equal((conn.updates.at(-1)?.update as any)?._meta?.piAcp?.running, false)
+})
+
