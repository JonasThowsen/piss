diff --git a/test/component/session-queue-cancel.test.ts b/test/component/session-queue-cancel.test.ts
index 041fe20..ee45ae8 100644
--- a/test/component/session-queue-cancel.test.ts
+++ b/test/component/session-queue-cancel.test.ts
@@ -3,6 +3,106 @@ import assert from 'node:assert/strict'
 import { PiAcpSession } from '../../src/acp/session.js'
 import { FakeAgentSideConnection, FakePiRpcProcess, asAgentConn } from '../helpers/fakes.js'
 
+const nextTick = () => new Promise<void>(resolve => setImmediate(resolve))
+
+test('PiAcpSession: queues prompts behind unsolicited background turns', async () => {
+  const conn = new FakeAgentSideConnection()
+  const proc = new FakePiRpcProcess()
+
+  const session = new PiAcpSession({
+    sessionId: 's1',
+    cwd: process.cwd(),
+    mcpServers: [],
+    proc: proc as any,
+    conn: asAgentConn(conn),
+    fileCommands: []
+  })
+
+  proc.emit({ type: 'agent_start' })
+  proc.emit({ type: 'agent_end', messages: [], willRetry: false })
+  await nextTick()
+
+  const runningUpdate = conn.updates.find(
+    message => (message.update as any)?._meta?.piAcp?.running === true
+  )
+  assert.ok(runningUpdate, 'unsolicited work must project running status')
+
+  const queued = session.prompt('after background work')
+  assert.equal(proc.prompts.length, 0, 'prompt must wait for the unsolicited turn')
+
+  proc.emit({ type: 'agent_settled' })
+  await nextTick()
+
+  assert.deepEqual(proc.prompts, [{ message: 'after background work', attachments: [] }])
+
+  proc.emit({ type: 'agent_start' })
+  proc.emit({ type: 'agent_end', messages: [], willRetry: false })
+  proc.emit({ type: 'agent_settled' })
+  assert.equal(await queued, 'end_turn')
+})
+
+test('PiAcpSession: a new unsolicited turn supersedes an older pending settlement', async () => {
+  const conn = new FakeAgentSideConnection()
+  const proc = new FakePiRpcProcess()
+
+  const session = new PiAcpSession({
+    sessionId: 's1',
+    cwd: process.cwd(),
+    mcpServers: [],
+    proc: proc as any,
+    conn: asAgentConn(conn),
+    fileCommands: []
+  })
+
+  proc.emit({ type: 'agent_start' })
+  proc.emit({ type: 'agent_end', messages: [], willRetry: false })
+  const queued = session.prompt('after both background turns')
+
+  proc.emit({ type: 'agent_settled' })
+  proc.emit({ type: 'agent_start' })
+  await nextTick()
+
+  assert.equal(proc.prompts.length, 0, 'stale settlement must not start the queued prompt')
+
+  proc.emit({ type: 'agent_end', messages: [], willRetry: false })
+  proc.emit({ type: 'agent_settled' })
+  await nextTick()
+
+  assert.deepEqual(proc.prompts, [{ message: 'after both background turns', attachments: [] }])
+
+  proc.emit({ type: 'agent_start' })
+  proc.emit({ type: 'agent_end', messages: [], willRetry: false })
+  proc.emit({ type: 'agent_settled' })
+  assert.equal(await queued, 'end_turn')
+})
+
+test('PiAcpSession: cancel clears prompts queued behind unsolicited work', async () => {
+  const conn = new FakeAgentSideConnection()
+  const proc = new FakePiRpcProcess()
+
+  const session = new PiAcpSession({
+    sessionId: 's1',
+    cwd: process.cwd(),
+    mcpServers: [],
+    proc: proc as any,
+    conn: asAgentConn(conn),
+    fileCommands: []
+  })
+
+  proc.emit({ type: 'agent_start' })
+  proc.emit({ type: 'agent_end', messages: [], willRetry: false })
+  const queued = session.prompt('cancel me')
+
+  await session.cancel()
+
+  assert.equal(proc.abortCount, 1)
+  assert.equal(await queued, 'cancelled')
+
+  proc.emit({ type: 'agent_settled' })
+  await nextTick()
+  assert.equal(proc.prompts.length, 0)
+})
+
