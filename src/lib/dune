; Backend-only library: SQLite stores, filesystem access, the
; workers registry. Pure types and protocol definitions are
; provided by `piss.shared` and re-exported through the umbrella
; `Piss_core` module in `piss_core.ml`.
;
; Anything that the browser shell (web/) needs must live in
; `piss.shared` instead.

(library
 (name piss_core)
 (public_name piss.core)
 (libraries piss.shared yojson sqlite3 unix)
 (wrapped true))
