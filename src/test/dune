(rule
 (alias interaction-test)
 (deps
  interaction.sh
  run_integration.sh
  ../worker/main.exe
  ../mock_agent/main.exe
  ../control/main.exe)
 (action
  (run
   bash
   %{dep:run_integration.sh}
   %{dep:interaction.sh}
   %{dep:../worker/main.exe}
   %{dep:../mock_agent/main.exe}
   %{dep:../control/main.exe})))

