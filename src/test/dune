(rule
 (alias interaction-test)
 (deps
  interaction.sh
  ../worker/main.exe
  ../mock_agent/main.exe
  ../control/main.exe
  ../../web/app.js
  (source_tree ../../web/public))
 (action
  (run
   bash
   %{dep:interaction.sh}
   %{dep:../worker/main.exe}
   %{dep:../mock_agent/main.exe}
   %{dep:../control/main.exe}
   %{workspace_root}/web/public
   %{dep:../../web/app.js}
   %{workspace_root})))

