(rule
 (alias runtest)
 (deps
  module_boundaries.sh
  ../../src/lib/dune
  ../../src/worker/dune
  ../../src/control/dune
  ../../src/mock_agent/dune
  ../../src/session_mcp/dune
  ../../src/bench/dune)
 (action
  (run bash %{dep:module_boundaries.sh} %{workspace_root})))

(rule
 (alias runtest)
 (deps worker_cli_ids.sh ../worker/main.exe)
 (action
  (run bash %{dep:worker_cli_ids.sh} %{dep:../worker/main.exe})))

(rule
 (alias runtest)
 (deps session_mcp_ids.py ../session_mcp/main.exe)
 (action
  (run python3 %{dep:session_mcp_ids.py} %{dep:../session_mcp/main.exe})))

